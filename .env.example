# Neon Postgres connection string.
# Leave blank in development and `pnpm dev` provisions a claimable database
# automatically via Neon Launchpad (https://neon.new) — those expire after 72h.
DATABASE_URL=
# Better Auth
BETTER_AUTH_SECRET=
# Base URL of the app, used to build auth links (password reset, email
# verification) — http://localhost:3000 in dev. In production this is pinned
# in wrangler.jsonc's `vars` instead (not secret, so it doesn't need
# `wrangler secret put`); this .env.local value never reaches the deployed
# Worker.
BETTER_AUTH_URL=http://localhost:3000
# Shared secret the Google Apps Script triggers send as the X-Webhook-Secret
# header on every POST to /api/webhooks/google-forms/*.
GOOGLE_FORMS_WEBHOOK_SECRET=
# Resend — transactional email (verification, password reset, granted/reset
# login credentials). The sending domain is verified in the Resend dashboard.
RESEND_API_KEY=
# Optional — defaults to "<APP_NAME> <noreply@notifications.everynationcampuswits.org>".
RESEND_FROM_EMAIL=
