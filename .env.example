# Neon Postgres connection string.
# Leave blank in development and `pnpm dev` provisions a claimable database
# automatically via Neon Launchpad (https://neon.new) — those expire after 72h.
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth
# Generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Base URL of the app. http://localhost:3000 in dev; the deployed origin in prod.
BETTER_AUTH_URL=http://localhost:3000
